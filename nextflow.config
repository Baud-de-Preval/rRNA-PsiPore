apptainer.enabled = true
conda.enabled = true
cleanup = true

process {
    // Default resources for all processes
    conda = 'environment.yml'
    cpus = 4
    memory = 8.GB
    time = 1.h
    errorStrategy = 'finish'

    // Process-specific resource configurations
    withName: 'dorado_basecall' {
        cpus = 4
        memory = 70.GB
        time = 6.h
        accelerator = 1
        clusterOptions = '--gres=gpu:nvidia_h100_80gb_hbm3_3g.40gb:1'
    }

    withName: 'seqtagger_demultiplex' {
        conda=null
        beforeScript = 'module load cuda && module load apptainer'
        cpus = 4
        memory = 24.GB
        time = 60.m
        accelerator = 1
        clusterOptions = '--gres=gpu:nvidia_h100_80gb_hbm3_1g.10gb:1'
    }

    withName: 'toullig_QC' {
        conda=null
        beforeScript = 'source /home/bseguine/scratch/ONT_pipeline/Pipeline/script/toulligQC/.venv/bin/activate'
        cpus   = 2
        memory = 4.GB
        time   = 30.min
    }

    withName: 'change_name' {
        conda = null
        cpus = 2
        memory = 1.GB
        time = 2.m
    }    

    withName: 'sort_index_bam' {
        cpus = 4
        memory = 10.GB
        time = 1.h
    }

    withName: 'seqtagger_index' {
        conda = null
        beforeScript = 'module load cuda && module load apptainer'
        cpus = 8
        memory = 16.GB
        time = 60.m
        accelerator = 1
        clusterOptions = '--gres=gpu:nvidia_h100_80gb_hbm3_1g.10gb:1'
    }

    withName: 'download_seqtagger_image' {
        conda = null
        beforeScript = 'module load cuda && module load apptainer'
    }

    withName: 'SingleReads' {
        conda = null
        cpus = 4
        memory = 32.GB
        time = 90.m
    }
}

executor {
    name = 'slurm'
    queueSize = 10
}